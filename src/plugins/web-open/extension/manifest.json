{
  "manifest_version": 3,
  "name": "Hiven Browser",
  "version": "0.4.0",
  "description": "Sends open tabs and history to Hiven for search.",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "alarms",
    "history",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:19246/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  }
}
